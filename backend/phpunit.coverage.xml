<?xml version="1.0" encoding="UTF-8"?>
<!--
    Coverage-only config, separate from phpunit.xml (T-06).

    Running the coverage flag against phpunit.xml's full `app` source scope
    with Xdebug's instrumentation overhead runs this machine out of memory (a
    documented constraint, see phpstan.neon's own comment on the same
    problem). Scoping `<source><include>` to app/Services only (the half T-06
    actually proposed a floor for: 90% Services, 70% overall) cuts the
    instrumented file count from 269 to 57 and keeps a coverage run possible
    on this machine at all. The test SUITE run is identical (every test still
    runs); only which files Xdebug tracks line hits for is narrowed.

    Run: vendor/bin/phpunit -c phpunit.coverage.xml with the coverage-text flag
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app/Services</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="marketing_crm_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
