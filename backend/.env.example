APP_NAME="Marketing CRM"
APP_ENV=local
APP_KEY=

# Deliberately false, unlike Laravel's shipped example (SEC-CFG-03).
#
# The deployment path for this project is copying this file on the server
# (DEPLOYMENT §3A - shared hosting, no build step), and a debug page leaks
# stack traces containing database credentials to anyone who triggers an error.
# Defaulting to true means one forgotten edit exposes them; defaulting to false
# means a developer sets it in their own .env, which they were going to do
# anyway. Fail closed.
APP_DEBUG=false

APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_TIMEZONE=UTC
ORG_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TEST_DATABASE=
# PostgreSQL only, and unused on the MySQL target - but config/database.php
# reads it, so it is documented rather than left as a surprise if anyone moves.
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Queue / Cache / Session
# `database` for shared hosting (no Redis/Supervisor); `redis` on a VPS.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie hardening (SEC-OPS-02). SESSION_SECURE_COOKIE is false here because a
# local box serves plain HTTP, and a Secure cookie on an insecure request is one
# the browser accepts and then never sends back - which looks like "login does
# nothing" rather than like a setting. It MUST be true on any host serving
# HTTPS: `crm:production-check` fails while it is off, and equally on
# SESSION_HTTP_ONLY off or SESSION_SAME_SITE=none.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=
# Optional literal prefix on issued API tokens, so a leaked one is greppable in
# a repository scan. Empty means no prefix, which is Laravel's default.
SANCTUM_TOKEN_PREFIX=
TOKEN_EXPIRY_DAYS=30
# Minutes a password reset link stays valid (SEC-AUTH-06). Short on purpose -
# the link lands in an inbox that may not be private.
AUTH_RESET_TOKEN_EXPIRE_MINUTES=20
# Microseconds every sendResetLink() call is padded to (SEC-AUTH-02). Must stay
# ABOVE the cost of one bcrypt at BCRYPT_ROUNDS, or the "account exists" branch
# takes measurably longer than the other and becomes a timing oracle. Laravel's
# own 200000 is below it at 12 rounds - see the note in config/auth.php.
AUTH_TIMEBOX_MICROSECONDS=600000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
RECORDINGS_DISK=recordings
RECORDINGS_RETENTION_DAYS=365
RECORDINGS_MAX_FILE_KB=25600

# Lead import (FR-LEAD-07). Uploaded files are bulk PII: keep them on a
# PRIVATE disk, and let the retention job delete them (SEC-PII-05).
LEAD_IMPORT_DISK=local
LEAD_IMPORT_MAX_FILE_KB=10240
LEAD_IMPORT_MAX_ROWS=50000
LEAD_IMPORT_CHUNK_SIZE=500
LEAD_IMPORT_FILE_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Mail (SEC-AUTH-06)
#
# Password reset is the ONLY account-recovery path in this application, and the
# only mail it sends. Both of the settings below fail silently if they are
# wrong: `log` writes the reset link to storage/logs and reports success, and a
# BLANK from-address is worse - an empty line here resolves to "" and does NOT
# fall through to the config default, so Symfony refuses to build the message
# ("An email must have a \"From\" or a \"Sender\" header") and nothing is ever
# sent. Never leave MAIL_FROM_ADDRESS empty. `crm:production-check` fails on it.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Credentials for the hosted transports config/services.php declares. Neither is
# selected by MAIL_MAILER today; they are listed because the config reads them.
POSTMARK_API_KEY=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Business rule configuration - see BUSINESS_RULES.md
# ---------------------------------------------------------------------------
CALLING_HOURS_START=09:00
CALLING_HOURS_END=20:00
CAMPAIGN_CAP_PER_DAY=2
CAMPAIGN_CAP_PER_WEEK=5
AI_INTEREST_CONFIDENCE_THRESHOLD=0.75
DISCOUNT_APPROVAL_THRESHOLD=15
IDLE_THRESHOLD_MINUTES=5

# How long a work session may go silent before the scheduler closes it as
# abandoned (FR-ATT-01). A closed browser produces no logout, and an open
# session accrues logged-in time for ever - which feeds telecaller reports and
# therefore pay. Needs the scheduler cron entry from DEPLOYMENT 6 to run at all.
ATTENDANCE_STALE_AFTER_MINUTES=240

# Where a lead CSV export is written, and for how long it stays downloadable
# (FR-LEAD-12, SEC-PII-05). The disk MUST be private - an export is the whole
# lead database in one file, which is the highest-value thing an insider can
# walk out with (SEC-PII-04). Retention is what stops it sitting there for ever.
LEAD_EXPORT_DISK=local
LEAD_EXPORT_RETENTION_DAYS=7
# Rows are streamed in chunks so the job never holds the whole result set in
# memory. Raise it for speed on a bigger box, lower it if the queue worker is
# memory-starved.
LEAD_EXPORT_CHUNK_SIZE=500

# Database backups (SEC-OPS-05). Every backup is encrypted with APP_KEY before
# it touches disk, so BACKUP_DISK must stay private - see config/backup.php.
# mysqldump/mysql paths are host-specific: this dev box needs XAMPP's full
# path, a real host may already have both on PATH.
BACKUP_DISK=backups
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_MYSQL_PATH=mysql
BACKUP_RETENTION_DAYS=30
# A restore needs CREATE/DROP/ALTER - more than the application's own
# least-privilege DB_USERNAME should hold (SEC-OPS-04). Blank here falls back
# to DB_USERNAME/DB_PASSWORD; set a real DBA credential in production.
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=

# How long queued work may sit unclaimed before `crm:production-check` calls the
# queue unstaffed. A worker started without --queue drains only `default` and
# every job here names a queue instead, so the failure is silent - the API still
# answers "queued" and failed_jobs stays empty (DEPLOYMENT 4). Generous on
# purpose: this is meant to catch "no worker at all", not "busy".
QUEUE_BACKLOG_ALERT_MINUTES=30

# Who is credited for a conversion when a lead changed hands (GLOSSARY 2.6).
# last_owner | first_interest. This decides what people are paid - confirm it
# before it drives commission (T-24). Also changeable in Settings.
ATTRIBUTION_MODEL=last_owner
FOLLOWUP_REMINDER_LEAD_MINUTES=15
LEAD_CONTACT_COOLDOWN_HOURS=24
TELECALLER_OPEN_LEAD_CAP=150
LEAD_ASSIGNMENT_METHOD=load_balanced

# Auto dialer (BR-CALL-02/03).
DIALER_MAX_QUEUE_SIZE=200
DIALER_CLAIM_TTL_MINUTES=15

# Interest engine (FR-INT-02). Blank disables the automatic follow-up; the
# other six effects still apply.
INTEREST_AUTO_FOLLOW_UP_HOURS=24

# How long a signed recording URL stays valid (SEC-FILE-03).
RECORDINGS_SIGNED_URL_MINUTES=10

# Requests per minute (NFR-04, T-04). Raising these is a security decision,
# not a performance one - the auth limiter is what stops password spraying.
RATE_LIMIT_AUTH=5
RATE_LIMIT_STANDARD=120
RATE_LIMIT_BULK=10
RATE_LIMIT_WEBHOOK=600

# ---------------------------------------------------------------------------
# Transport and browser security - config/security.php (SEC-OPS-02, T-30, T-39)
#
# These carry REAL values, not blanks. Every one of them is read with a default
# in config/security.php, and an empty line here overrides that default with ""
# rather than falling through to it - which sends an empty X-Frame-Options and
# turns the boolean switches off.
# ---------------------------------------------------------------------------

# Which upstream proxies may set X-Forwarded-*. `*` = trust whoever connected,
# which is correct on the shared-hosting target (DEPLOYMENT 3A) where the app is
# reachable only through the provider's proxy, and WRONG on a public host: it
# lets a client choose its own X-Forwarded-For, and so the IP that rate limits
# and audit rows are keyed on. Behind your own load balancer, pin this to that
# balancer's address (comma-separated; the literal REMOTE_ADDR is accepted).
TRUSTED_PROXIES=*

SECURITY_HEADERS_ENABLED=true

# HSTS is cached by the browser for max_age seconds, so a mistake here outlives
# the fix by up to a year. Turn INCLUDE_SUBDOMAINS off BEFORE the first deploy
# if any subdomain has to stay HTTP; leave PRELOAD off until somebody has
# decided to submit the domain, because removal from that list takes months.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_CROSS_DOMAIN_POLICIES=none

# Not sent when empty, which is the default on purpose: the obvious value blocks
# the microphone, and call recording needs it (see config/security.php).
SECURITY_PERMISSIONS_POLICY=

# CSP. Read the block above the `csp` key in config/security.php before
# tightening any of this - the current views need 'unsafe-inline' and the CDN
# host, and turning ALLOW_INLINE off renders every screen unusable. Set
# REPORT_ONLY=true for a week to find out what would break first.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_REPORT_URI=
SECURITY_CSP_CDN_HOSTS=https://cdn.jsdelivr.net
SECURITY_CSP_ALLOW_INLINE=true

# ---------------------------------------------------------------------------
# Communication providers - keys are ALWAYS empty in this file (SEC-CFG-02)
# ---------------------------------------------------------------------------
MAILERCLOUD_API_KEY=
MAILERCLOUD_FROM_EMAIL=
MAILERCLOUD_FROM_NAME=
MAILERCLOUD_WEBHOOK_SECRET=

WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=

BHASHSMS_USER=
BHASHSMS_PASSWORD=
BHASHSMS_SENDER_ID=

RCS_PROVIDER=
RCS_API_KEY=

VOICE_PROVIDER=
VOICE_API_KEY=

# Delivery status for SMS, WhatsApp, RCS and Voice (FR-COMM-03). One generic
# endpoint - /api/v1/webhooks/delivery - carries all four, because three of the
# vendors are not chosen yet (T-31/32/33) and the channel travels in the body.
# Presented as X-Webhook-Token; until it is set the endpoint refuses everything,
# which is right for one that can mark messages delivered and suppress leads.
DELIVERY_WEBHOOK_SECRET=

# Inbound keyword opt-out (STOP/UNSUBSCRIBE) webhook - BR-DNC-05/07.
# Presented as X-Webhook-Token; until it is set the endpoint refuses everything.
INBOUND_WEBHOOK_SECRET=

VAAAD_API_KEY=
VAAAD_WEBHOOK_SECRET=

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Payment gateway (FR-PAY-02, T-34). Razorpay is the default and the only one
# implemented - leaving PAYMENT_GATEWAY blank selects it. Naming another gateway
# refuses rather than falling back, so collection can never happen through a
# provider nobody chose.
#
# PAYMENT_KEY_ID / PAYMENT_KEY_SECRET are Razorpay's API credentials; without
# them the payment-link endpoint returns 503 naming the missing field instead of
# issuing a link that collects nothing. PAYMENT_WEBHOOK_SECRET is the secret
# entered in the Razorpay dashboard when subscribing the webhook - until it is
# set, /api/v1/webhooks/payment rejects every request.
PAYMENT_GATEWAY=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
