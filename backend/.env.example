APP_NAME="Marketing CRM"
APP_ENV=local
APP_KEY=

# Deliberately false, unlike Laravel's shipped example (SEC-CFG-03).
#
# The deployment path for this project is copying this file on the server
# (DEPLOYMENT §3A - shared hosting, no build step), and a debug page leaks
# stack traces containing database credentials to anyone who triggers an error.
# Defaulting to true means one forgotten edit exposes them; defaulting to false
# means a developer sets it in their own .env, which they were going to do
# anyway. Fail closed.
APP_DEBUG=false

APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_TIMEZONE=UTC
ORG_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TEST_DATABASE=

# ---------------------------------------------------------------------------
# Queue / Cache / Session
# `database` for shared hosting (no Redis/Supervisor); `redis` on a VPS.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=
TOKEN_EXPIRY_DAYS=30
# Minutes a password reset link stays valid (SEC-AUTH-06). Short on purpose -
# the link lands in an inbox that may not be private.
AUTH_RESET_TOKEN_EXPIRE_MINUTES=20

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
RECORDINGS_DISK=recordings
RECORDINGS_RETENTION_DAYS=365
RECORDINGS_MAX_FILE_KB=25600

# Lead import (FR-LEAD-07). Uploaded files are bulk PII: keep them on a
# PRIVATE disk, and let the retention job delete them (SEC-PII-05).
LEAD_IMPORT_DISK=local
LEAD_IMPORT_MAX_FILE_KB=10240
LEAD_IMPORT_MAX_ROWS=50000
LEAD_IMPORT_CHUNK_SIZE=500
LEAD_IMPORT_FILE_RETENTION_DAYS=30

MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Business rule configuration - see BUSINESS_RULES.md
# ---------------------------------------------------------------------------
CALLING_HOURS_START=09:00
CALLING_HOURS_END=20:00
CAMPAIGN_CAP_PER_DAY=2
CAMPAIGN_CAP_PER_WEEK=5
AI_INTEREST_CONFIDENCE_THRESHOLD=0.75
DISCOUNT_APPROVAL_THRESHOLD=15
IDLE_THRESHOLD_MINUTES=5

# Who is credited for a conversion when a lead changed hands (GLOSSARY 2.6).
# last_owner | first_interest. This decides what people are paid - confirm it
# before it drives commission (T-24). Also changeable in Settings.
ATTRIBUTION_MODEL=last_owner
FOLLOWUP_REMINDER_LEAD_MINUTES=15
LEAD_CONTACT_COOLDOWN_HOURS=24
TELECALLER_OPEN_LEAD_CAP=150
LEAD_ASSIGNMENT_METHOD=load_balanced

# Auto dialer (BR-CALL-02/03).
DIALER_MAX_QUEUE_SIZE=200
DIALER_CLAIM_TTL_MINUTES=15

# Interest engine (FR-INT-02). Blank disables the automatic follow-up; the
# other six effects still apply.
INTEREST_AUTO_FOLLOW_UP_HOURS=24

# How long a signed recording URL stays valid (SEC-FILE-03).
RECORDINGS_SIGNED_URL_MINUTES=10

# Requests per minute (NFR-04, T-04). Raising these is a security decision,
# not a performance one - the auth limiter is what stops password spraying.
RATE_LIMIT_AUTH=5
RATE_LIMIT_STANDARD=120
RATE_LIMIT_BULK=10
RATE_LIMIT_WEBHOOK=600

# ---------------------------------------------------------------------------
# Communication providers - keys are ALWAYS empty in this file (SEC-CFG-02)
# ---------------------------------------------------------------------------
MAILERCLOUD_API_KEY=
MAILERCLOUD_FROM_EMAIL=
MAILERCLOUD_FROM_NAME=
MAILERCLOUD_WEBHOOK_SECRET=

WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

BHASHSMS_USER=
BHASHSMS_PASSWORD=
BHASHSMS_SENDER_ID=

RCS_PROVIDER=
RCS_API_KEY=

VOICE_PROVIDER=
VOICE_API_KEY=

# Inbound keyword opt-out (STOP/UNSUBSCRIBE) webhook - BR-DNC-05/07.
# Presented as X-Webhook-Token; until it is set the endpoint refuses everything.
INBOUND_WEBHOOK_SECRET=

VAAAD_API_KEY=
VAAAD_WEBHOOK_SECRET=

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Payment gateway (FR-PAY-02, T-34). Razorpay is the default and the only one
# implemented - leaving PAYMENT_GATEWAY blank selects it. Naming another gateway
# refuses rather than falling back, so collection can never happen through a
# provider nobody chose.
#
# PAYMENT_KEY_ID / PAYMENT_KEY_SECRET are Razorpay's API credentials; without
# them the payment-link endpoint returns 503 naming the missing field instead of
# issuing a link that collects nothing. PAYMENT_WEBHOOK_SECRET is the secret
# entered in the Razorpay dashboard when subscribing the webhook - until it is
# set, /api/v1/webhooks/payment rejects every request.
PAYMENT_GATEWAY=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
